{
  "id": "jabworks.stack",
  "adapter": "jabworks",
  "name": "스택",
  "category": "layout",
  "version": "0.1.0",
  "status": "placeholder",
  "_note": "리듬 강제 핵심 컴포넌트. gap은 spacing 토큰만 받음.",
  "description": "수직/수평 레이아웃 컨테이너. gap·align·justify를 토큰만으로 강제.",
  "useWhen": ["여러 자식 요소 정렬 + 간격 통제", "위계와 리듬을 만드는 핵심 도구"],
  "doNotUseWhen": ["복잡한 그리드는 layout.basic 사용"],
  "props": [
    { "name": "direction", "type": "enum", "enum": ["vertical", "horizontal"], "default": "vertical" },
    { "name": "gap", "type": "enum", "enum": ["xs", "sm", "md", "lg", "xl", "2xl", "3xl"], "default": "md" },
    { "name": "align", "type": "enum", "enum": ["start", "center", "end", "stretch"], "default": "stretch" },
    { "name": "justify", "type": "enum", "enum": ["start", "center", "end", "between", "around"], "default": "start" },
    { "name": "wrap", "type": "boolean", "default": false }
  ],
  "slots": [{ "name": "children", "type": "ComponentInstance[]" }],
  "a11y": { "roles": [], "requiredAttrs": [], "keyboard": {} },
  "states": { "required": ["default"] },
  "tokenBindings": { "_note": "워크숍 후 확정" },
  "renderer": "react",
  "reactPath": "@design-works/components/adapters/jabworks/Stack",
  "exemplaryUsages": []
}
