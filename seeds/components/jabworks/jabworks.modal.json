{
  "id": "jabworks.modal",
  "adapter": "jabworks",
  "name": "모달",
  "category": "feedback",
  "version": "0.1.0",
  "status": "placeholder",
  "_note": "포커스 트랩 + ESC 닫기 + 첫 포커스 위치 워크숍에서 확정.",
  "description": "주의를 끄는 오버레이 다이얼로그.",
  "useWhen": ["사용자 의사 결정 요구", "흐름 차단이 필요할 때만"],
  "doNotUseWhen": ["단순 알림은 toast"],
  "props": [
    { "name": "open", "type": "boolean", "required": true },
    { "name": "title", "type": "string", "required": true },
    { "name": "size", "type": "enum", "enum": ["sm", "md", "lg"], "default": "md" }
  ],
  "slots": [
    { "name": "body", "type": "ComponentInstance[] | string" },
    { "name": "actions", "type": "ComponentInstance[]" }
  ],
  "a11y": {
    "roles": ["dialog"],
    "requiredAttrs": [
      { "selector": "[role=dialog]", "attr": "aria-modal", "valuePattern": "true" },
      { "selector": "[role=dialog]", "attr": "aria-labelledby", "valuePattern": ".+" }
    ],
    "keyboard": { "Escape": "닫기" }
  },
  "states": { "required": ["default"] },
  "tokenBindings": { "_note": "워크숍 후 확정" },
  "renderer": "react",
  "reactPath": "@design-works/components/adapters/jabworks/Modal",
  "exemplaryUsages": []
}
