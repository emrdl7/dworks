{
  "id": "jabworks.layout.basic",
  "adapter": "jabworks",
  "name": "기본 레이아웃",
  "category": "layout",
  "version": "0.1.0",
  "status": "placeholder",
  "_note": "skip-nav 자동 삽입 + main 시멘틱 강제.",
  "description": "페이지 최외곽 레이아웃. header / main / footer 슬롯.",
  "useWhen": ["거의 모든 페이지의 루트"],
  "doNotUseWhen": ["임베드용 부분 렌더는 stack"],
  "props": [
    { "name": "title", "type": "string", "required": true },
    { "name": "maxWidth", "type": "enum", "enum": ["sm", "md", "lg", "xl", "full"], "default": "lg" }
  ],
  "slots": [
    { "name": "header", "type": "ComponentInstance[] | string" },
    { "name": "main", "type": "ComponentInstance[]" },
    { "name": "footer", "type": "ComponentInstance[] | string" }
  ],
  "a11y": {
    "roles": [],
    "requiredAttrs": [
      { "selector": "main", "attr": "id", "valuePattern": "main" },
      { "selector": "a.skip-nav", "attr": "href", "valuePattern": "#main" }
    ],
    "keyboard": {}
  },
  "states": { "required": ["default"] },
  "tokenBindings": { "_note": "워크숍 후 확정" },
  "renderer": "react",
  "reactPath": "@design-works/components/adapters/jabworks/LayoutBasic",
  "exemplaryUsages": []
}
